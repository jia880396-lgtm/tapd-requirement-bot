# TAPD 配置
TAPD_API_ENDPOINT=https://api.tapd.cn
TAPD_AUTH_TOKEN=请填入40位十六进制TAPD_API_Token
TAPD_WORKSPACE_IDS=your_tapd_workspace_id
# 可选：部分接口需 Basic 认证（API User）
TAPD_API_USER=

# 大模型配置（汇智 AI 网关 OpenAI 兼容端点）
DEEPSEEK_API_KEY=请填入你的API_KEY
DEEPSEEK_BASE_URL=https://your-llm-gateway.example.com/v1
DEEPSEEK_MODEL=qwen3-vl-plus

# 服务配置
HOST=0.0.0.0
PORT=8030
DB_PATH=./data/requirement_agent.db
ENVIRONMENT=production
SECRET_KEY=请修改为随机字符串

# 机器人配置
BOT_NAME=TAPD需求处理辅助工具
SCHEDULE_INTERVAL_MINUTES=30
BATCH_SIZE=50

# 需求状态过滤（逗号分隔）
STORY_STATUS_FILTER=status_2

# 重复需求对应的 TAPD status 值（确认重复时写回 TAPD 用，请填入实际值如 status_7）
STORY_STATUS_DUPLICATE=status_16

# PRD 分析界面拉取需求的状态（待评审）
STORY_STATUS_PRD_REVIEW=status_23

# 业务阈值
RELIABILITY_THRESHOLD=60.0
DUPLICATE_HISTORY_LIMIT=500

# 自定义字段映射（TAPD 自定义字段编号，需根据实际项目调整）
CUSTOM_FIELD_TENANT_VERSION=custom_field_17
CUSTOM_FIELD_PRIORITY=custom_field_18
CUSTOM_FIELD_PRD=custom_field_19
CUSTOM_FIELD_USER_REQUIREMENT=custom_field_20

# 日志目录
LOG_DIR=./logs

# 补充问题配置
QUESTION_MAX_COUNT=3
QUESTION_FOCUS=problem_scenario

# 评分标准（loose=宽松 / strict=严格）
SCORING_STRICTNESS=loose

# PRD 分析配置
PRD_STRICTNESS=loose
PRD_PASS_THRESHOLD=60
PRD_WEIGHT_COVERAGE=30
PRD_WEIGHT_FUNCTIONAL=25
PRD_WEIGHT_INTERACTION=20
PRD_WEIGHT_ACCEPTANCE=25
STORY_STATUS_PRODUCT_DESIGNING=status_21
AUTO_ASSIGN_OWNER=false

# 图片理解视觉模型（与文本同走汇智 AI 网关，qwen3-vl-plus 支持图片输入）
VISION_BASE_URL=https://your-llm-gateway.example.com/v1
VISION_API_KEY=请填入你的API_KEY
VISION_MODEL=qwen3-vl-plus
